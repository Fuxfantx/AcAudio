name: "AcAudio"

platforms:
    wasm-web:
        context:
            flags: ["-std=c++11", "-O3", "-ffunction-sections", "-fdata-sections", "-flto"]
            linkFlags: ["-flto"]
            defines: ["MINIAUDIO_IMPLEMENTATION", "MA_NO_FLAC", "MA_NO_OPUS", "MA_NO_VORBIS", "MA_NO_ENCODING", "MA_NO_GENERATION", "MA_ENABLE_ONLY_SPECIFIC_BACKENDS", "MA_ENABLE_WEBAUDIO"]